# The one place upstream versions are pinned (BB-R-011.6). Read by compose
# (--env-file), the Gradle build, the server image build and CI; Helm reads it in #18.
# Bump versions here and nowhere else; deploy/ci/check-deploy.sh fails on drift.

# Container images
POSTGRES_VERSION=17.11-alpine
KEYCLOAK_VERSION=26.7.4
TEMURIN_VERSION=21.0.12_8-jre-alpine

# Test-only: ArchUnit asserts the core/policy seam (issue #7)
ARCHUNIT_VERSION=1.5.0

# Java build. SPRING_BOOT_VERSION follows the Boot line HAPI is built against
# (spring_boot_version in the hapi-fhir parent POM); move them together.
HAPI_FHIR_VERSION=8.12.1
# Admin REST client library; its 26.0.x line is the one that serves every Keycloak 26.x server
KEYCLOAK_ADMIN_CLIENT_VERSION=26.0.12
SPRING_BOOT_VERSION=3.5.16

# Big Book itself: the Gradle project version and the server image tag
BIGBOOK_VERSION=0.1.0-SNAPSHOT
